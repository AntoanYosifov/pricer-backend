# Copy to .env before running `docker compose up -d`.
# Local development credentials only — never reuse these for a deployment.
#
# NOTE: these values are only applied when the data volume is first created.
# Changing them later has no effect on an existing pricer_mysql_data volume.

MYSQL_ROOT_PASSWORD=example_password
MYSQL_DATABASE=pricer
MYSQL_USER=example_user
MYSQL_PASSWORD=example_password
