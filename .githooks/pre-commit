#!/bin/sh
# Block the commit if the staged changes contain a secret.
# Activate once per clone: git config core.hooksPath .githooks

set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed. Run: brew install gitleaks" >&2
  echo "pre-commit: refusing to commit without a secret scan." >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --verbose

